# --- Database ---
# Postgres connection string (Supabase, Railway, Neon, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/tandem?schema=public"

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=""
# The public HTTPS URL your Next.js app is deployed at (the Mini App URL
# you register with @BotFather via /newapp). Must be HTTPS in production.
TELEGRAM_WEBAPP_URL="https://your-app.example.com"
# Bot's @username without the @ — used client-side to build t.me invite
# deep links (NEXT_PUBLIC_ prefix means this is bundled into the frontend,
# so it's fine that it's public; it's not a secret).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Короткое имя Mini App из BotFather (/newapp), то есть "tandem" из
# t.me/<бот>/tandem. Нужно для invite-ссылки t.me/<бот>/<app>?startapp=…
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=""

# --- App ---
APP_URL="https://your-app.example.com"
# Random 32+ char string, used to sign any server-side session cookie you add.
SESSION_SECRET=""
# Shared secret required as a query param on /api/notifications/cron so it
# can't be triggered by anyone who finds the URL.
CRON_SECRET=""

# --- Dev mode ---
# When "true" AND NODE_ENV !== "production", API routes accept requests with
# no Telegram initData and fall back to a fixed dev user (telegramId=1).
# lib/telegram-auth.ts refuses this bypass outright whenever NODE_ENV is
# "production", regardless of this value, as a hard safety net.
ALLOW_DEV_AUTH="true"

# --- Поиск клиентов (модуль лидов: bot/leads, lib/leads) ---
# Ключ Яндекс «API Поиска по организациям» — основной источник бизнесов.
# Кабинет разработчика Яндекса → подключить «API Поиска по организациям».
# Без ключа «🔎 Найти клиентов» честно покажет «Поиск клиентов пока не
# настроен» и предложит искать только по OpenStreetMap (данных меньше).
YANDEX_PLACES_API_KEY=""
# OpenStreetMap — проверка и дополнение данных (ключ не нужен). "false" — выключить.
LEADS_OSM_ENABLED="true"
# Необязательно: свои серверы Overpass через запятую (по умолчанию — публичные).
OVERPASS_API_URL=""
# Тексты предложений: "template" (шаблон строго по фактам о лиде).
# Позже — "claude" (см. lib/leads/proposal/index.ts) + ANTHROPIC_API_KEY.
LEADS_PROPOSAL_ENGINE="template"
# Часовой пояс для дат в истории поиска.
LEADS_TIMEZONE="Europe/Moscow"

# --- File storage (attachments) ---
# Any S3-compatible provider (S3, Cloudflare R2, Supabase Storage, Backblaze B2).
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"
