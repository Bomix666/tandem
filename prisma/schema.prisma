// Tandem — data model
// Two-person shared task workspace for a Telegram Mini App.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
  WORKING
}

enum RecurrenceFrequency {
  NEVER
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  CUSTOM
}

model User {
  id           String   @id @default(cuid())
  telegramId   BigInt   @unique
  username     String?
  firstName    String
  lastName     String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime @default(now())

  memberships       WorkspaceMember[]
  createdTasks      Task[]              @relation("TaskCreator")
  assignedTasks     Task[]              @relation("TaskAssignee")
  comments          TaskComment[]
  attachments       TaskAttachment[]
  activity          TaskActivity[]
  presence          Presence?
  notificationPrefs NotificationPreference?
  notifications     Notification[]
}

// Enforced at the application layer: max 2 members per workspace.
model Workspace {
  id        String   @id @default(cuid())
  name      String   @default("Tandem")
  inviteToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  tasks       Task[]
  recurrences RecurringTask[]

  // модуль поиска клиентов (см. раздел «Leads» в конце файла)
  leads        Lead[]
  leadSearches LeadSearch[]
  leadSettings LeadSettings?
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  joinedAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([userId]) // a user belongs to exactly one workspace in this product
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  creatorId    String
  assigneeId   String
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  progress     Int        @default(0) // 0-100
  priority     Priority   @default(MEDIUM)
  deadlineAt   DateTime
  sortOrder    Int        @default(0)
  recurrenceId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User            @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    User            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  recurrence  RecurringTask?  @relation(fields: [recurrenceId], references: [id])
  comments    TaskComment[]
  attachments TaskAttachment[]
  activity    TaskActivity[]
  notifications Notification[]
  leadLinks   LeadTask[] // только обратная связь Prisma — колонок в Task не добавляет

  @@index([workspaceId, status])
  @@index([workspaceId, deadlineAt])
}

model RecurringTask {
  id          String               @id @default(cuid())
  workspaceId String
  title       String
  description String?
  assigneeId  String
  priority    Priority             @default(MEDIUM)
  frequency   RecurrenceFrequency
  // for CUSTOM: array of ISO weekday numbers (1=Mon..7=Sun)
  weekdays    Int[]                @default([])
  timeOfDay   String               // "HH:mm" the next occurrence is generated for
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String?
  workspaceId String
  actorId   String
  type      String   // 'task_created' | 'task_updated' | 'task_completed' | 'task_reopened' |
                      // 'deadline_changed' | 'progress_changed' | 'comment_added' |
                      // 'attachment_added' | 'work_started' | 'work_stopped'
  meta      Json?
  createdAt DateTime @default(now())

  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
}

model Presence {
  userId       String          @id
  status       PresenceStatus  @default(OFFLINE)
  workingTaskId String?
  lastSeenAt   DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  userId              String  @id
  deadline24h         Boolean @default(true)
  deadline3h          Boolean @default(true)
  deadline1h          Boolean @default(true)
  deadline30m         Boolean @default(true)
  deadline10m         Boolean @default(false)
  friendCreatedTask   Boolean @default(true)
  assignedNewTask     Boolean @default(true)
  friendCompletedTask Boolean @default(true)
  friendStartedWorking Boolean @default(false)
  commentAdded        Boolean @default(true)
  taskOverdue         Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  type      String
  payload   Json?
  sentAt    DateTime?
  scheduledFor DateTime
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // prevents duplicate scheduling of the same reminder for the same task
  @@unique([taskId, userId, type])
  @@index([scheduledFor, sentAt])
}

// ---------------------------------------------------------------------------
// Leads — модуль поиска клиентов на разработку сайтов (lib/leads, bot/leads).
// Только новые таблицы: существующие модели выше не меняются (добавлены лишь
// обратные связи Prisma, которые колонок не создают).
// ---------------------------------------------------------------------------

enum LeadStatus {
  FOUND       // 🔎 Найден — результат поиска, ещё не разобран
  NEW         // 🆕 Новый — сохранён / взят в работу
  TO_CONTACT  // 📩 Связаться
  CONTACTED   // 💬 Написали
  WAITING     // ⏳ Ждём ответа
  NEGOTIATION // 🤝 Переговоры
  CLIENT      // 💰 Клиент
  REJECTED    // ❌ Отказ
  NOT_FIT     // 🚫 Не подходит
}

enum LeadPotential {
  HIGH
  MEDIUM
  LOW
}

enum LeadSearchStatus {
  RUNNING
  DONE
  FAILED
}

// Один найденный бизнес. Лиды общие для рабочего пространства (как и задачи).
// Дубли определяются в lib/leads/dedupe.ts по id в источнике, домену,
// телефону и названию+адресу; уникальные индексы ниже — страховка на уровне БД.
model Lead {
  id          String @id @default(cuid())
  workspaceId String

  name        String
  normName    String // нормализованное название для поиска дублей
  city        String
  niche       String
  category    String? // категория из источника (например, «Барбершоп»)
  address     String?
  normAddress String?
  lat         Float?
  lon         Float?

  websiteKind String  @default("none") // own | social | booking | none
  website     String? // собственный сайт (соцсети и таплинки сюда не попадают)
  domain      String?
  bookingPage Json? // { name: "YCLIENTS", url } — если вместо сайта страница записи
  phones     String[] @default([])
  normPhones String[] @default([]) // только цифры, 7XXXXXXXXXX
  emails     String[] @default([])
  socials    Json? // [{ type: "instagram", url: "https://..." }]
  hours      String?

  yandexId String?
  osmId    String? // "node/123", "way/456"
  sources  Json // [{ provider: "yandex" | "osm", url: "https://..." }]

  chainSize  Int     @default(1) // сколько точек с таким названием было в выдаче
  nicheMatch Boolean @default(true)

  siteAudit    Json? // результат проверки сайта (lib/leads/site-audit.ts)
  score        Int           @default(0) // 0–100: соответствие критериям поиска клиента
  scoreReasons Json? // [{ label, points }]
  potential    LeadPotential @default(MEDIUM)
  offer        String? // что можно предложить

  status          LeadStatus @default(NEW)
  statusChangedAt DateTime   @default(now())
  saved           Boolean    @default(false) // ❤️
  proposal        String? // последний сгенерированный текст предложения

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchResults LeadSearchResult[]
  tasks         LeadTask[]
  contacts      LeadContact[]
  events        LeadEvent[]
  outreach      Outreach[]

  @@unique([workspaceId, yandexId])
  @@unique([workspaceId, osmId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, domain])
  @@index([workspaceId, normName])
}

// Один запуск поиска (история поиска). «Найти ещё» — новый запуск с parentId.
model LeadSearch {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  chatId      BigInt?
  niche       String
  city        String
  requested   Int
  extra       String? // «Дополнительно» как ввёл пользователь
  osmOnly     Boolean          @default(false)
  source      String           @default("osm") // osm | yandex — откуда брали бизнесы
  parentId    String?
  status      LeadSearchStatus @default(RUNNING)
  found       Int              @default(0)
  checked     Int              @default(0)
  filtered    Int              @default(0)
  candidates  Int              @default(0) // сколько бизнесов нашли источники (до проверки)
  withEmail   Int              @default(0) // подходящих лидов с публичным email
  needsReview Int              @default(0) // email только 🟡 или сайт не удалось проверить
  stage       String? // что делается сейчас («Проверяю сайты…») — для прогресса в приложении
  nextOffset  Int              @default(0) // смещение в выдаче источника для «Найти ещё»
  warnings    Json? // ["Не удалось получить данные из OSM", ...]
  rejectedKeys Json? // отклонённые кандидаты — «Найти ещё» их не перепроверяет
  error       String?
  createdAt   DateTime         @default(now())
  finishedAt  DateTime?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results   LeadSearchResult[]

  @@index([workspaceId, createdAt])
}

model LeadSearchResult {
  id          String  @id @default(cuid())
  searchId    String
  leadId      String
  position    Int
  wasExisting Boolean @default(false) // лид уже был в базе до этого поиска

  search LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead   Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([searchId, leadId])
  @@unique([searchId, position])
}

// Связь «лид → задача». Таблица Task не меняется: связь живёт здесь.
model LeadTask {
  id         String       @id @default(cuid())
  leadId     String
  taskId     String       @unique
  kind       LeadTaskKind @default(CONTACT)
  outreachId String? // для follow-up — к какому обращению относится (этап 2)
  createdAt  DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadSettings {
  workspaceId   String  @id
  avgCheck      Int     @default(50000) // средний чек, ₽ — только для расчёта в статистике
  senderName    String? // подпись в предложениях: имя
  companyName   String? // студия / компания
  portfolioUrl  String?
  senderContact String? // телефон или Telegram для подписи

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum LeadTaskKind {
  CONTACT   // «Связаться с …»
  FOLLOW_UP // напоминание после обращения (этап 2)
}

// ---------------------------------------------------------------------------
// Контакты лида с источником и проверкой. Сейчас — только email бизнеса;
// телефоны и соцсети переедут сюда позже (та же таблица, kind = PHONE/SOCIAL).
// Lead.emails остаётся кешем принятых по правилам адресов — для списков.
// ---------------------------------------------------------------------------

enum ContactKind {
  EMAIL
  PHONE
  SOCIAL
}

enum ContactSource {
  OSM
  YANDEX
  SITE
  MANUAL
}

enum EmailCheck {
  VALID      // 🟢 формат, MX и домен совпадает с сайтом компании
  UNVERIFIED // 🟡 найден, но не подтверждён (другой домен, бесплатная почта, DNS не ответил)
  INVALID    // 🔴 битый формат или у домена нет почты
}

model LeadContact {
  id           String        @id @default(cuid())
  workspaceId  String
  leadId       String
  kind         ContactKind
  value        String
  normalized   String // для поиска дублей
  role         String? // почему признан адресом компании: "info", "sales", "brand"…
  sourceType   ContactSource
  sourceUrl    String? // страница, где найден
  verification EmailCheck?
  checkNote    String? // «MX есть, домен совпадает с сайтом»
  checkedAt    DateTime?
  isPrimary    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lead     Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  outreach Outreach[]

  @@unique([leadId, kind, normalized])
  @@index([workspaceId, kind])
}

// История лида: из неё строятся аналитика и «Сегодня» (этап 2).
enum LeadEventType {
  FOUND
  SAVED
  STATUS_CHANGED
  CONTACT_FOUND
  TASK_CREATED
  OUTREACH_DRAFTED
  OUTREACH_SENT
  REPLY_RECEIVED
  FOLLOWUP_SET
  FOLLOWUP_DONE
}

model LeadEvent {
  id          String        @id @default(cuid())
  workspaceId String
  leadId      String
  actorId     String? // пользователь; null — система (поиск)
  type        LeadEventType
  fromStatus  LeadStatus?
  toStatus    LeadStatus?
  meta        Json?
  createdAt   DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([workspaceId, type, createdAt])
}

// Обращение к лиду. Сейчас сюда пишутся черновики «✨ предложения»;
// редактор, каналы, отправка и follow-up — этап 2. Отправка — только руками.
enum OutreachChannel {
  EMAIL
  TELEGRAM
  WHATSAPP
  SOCIAL
}

enum OutreachStatus {
  DRAFT     // 📝 Черновик
  READY     // 📤 Готово к отправке
  SENT      // 📨 Отправлено
  WAITING   // ⏳ Ждём ответа
  REPLIED   // 👀 Ответ получен
  FOLLOW_UP // 🔁 Follow-up
  REJECTED  // ❌ Отказ
  CLIENT    // 🤝 Клиент
}

model Outreach {
  id          String          @id @default(cuid())
  workspaceId String
  leadId      String
  createdById String?
  channel     OutreachChannel
  status      OutreachStatus  @default(DRAFT)
  recipient   String? // email / телефон / ссылка
  contactId   String?
  subject     String?
  body        String
  generator   String // "template" сейчас, "claude" — когда подключим
  variant     Int             @default(0)
  sentAt      DateTime?
  repliedAt   DateTime?
  followUpAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lead    Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact LeadContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Локальная копия OpenStreetMap — основной источник бизнесов. Общая для всех
// пространств; наполняется scripts/osm-import.ts (раз в неделю, вся Россия).
// Данные © участники OpenStreetMap, лицензия ODbL.
// ---------------------------------------------------------------------------

model OsmPlace {
  id         String   @id // "node/123", "way/456", "relation/789"
  name       String
  lat        Float
  lon        Float
  kinds      String[] // ["shop=hairdresser", "amenity=dentist"] — по ним ищется ниша
  tags       Json // нужные теги: адрес, контакты, часы, уточнения ниши
  phone      String?
  website    String?
  email      String?
  hasContact Boolean
  importId   String
  updatedAt  DateTime @updatedAt

  @@index([kinds], type: Gin)
  @@index([lat, lon])
  @@index([importId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "OsmPlace_name_trgm_idx") // «своя ниша»: поиск по названию
}

model OsmImport {
  id         String    @id @default(cuid())
  regions    String[]
  status     String // RUNNING | DONE | FAILED
  sourceDate DateTime? // дата выгрузки Geofabrik (Last-Modified)
  places     Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
}

// Границы городов/регионов для поиска по локальной копии OSM:
// определяются через Nominatim один раз и хранятся навсегда.
model OsmArea {
  key       String   @id // нормализованный запрос пользователя
  name      String // как назвал Nominatim
  kind      String // city | region
  south     Float
  west      Float
  north     Float
  east      Float
  geometry  Json? // упрощённый контур (GeoJSON Polygon/MultiPolygon); нет — ищем по прямоугольнику
  source    String   @default("nominatim")
  createdAt DateTime @default(now())
}
